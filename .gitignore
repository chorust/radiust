# Generated by Cargo
# will have compiled files and executables
debug
target

# Python build and test artifacts
__pycache__/
*.py[cod]
*.so
.venv/
venv/
dist/
build/
*.egg-info/
.pytest_cache/
.ruff_cache/
coverage.xml
.coverage

# Local application data and validation output
data/
.cache/
.env*

# Editors and operating-system files
.DS_Store
Thumbs.db
*.tmp
*.swp
.vscode/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

#agent
.agents/


# Keep checked-in source replay artifacts visible to Git; runtime outputs above
# remain ignored outside the fixture tree.
!tests/fixtures/sources/**/*.gif
!tests/fixtures/sources/**/*.png
!tests/fixtures/sources/**/*.jpg
!tests/fixtures/sources/**/*.jpeg
!tests/fixtures/sources/**/*.webp

*.whl

#
